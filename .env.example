# ==============================================================================
# MULTIPATH Educational Platform — Environment Configuration Template
# ==============================================================================

# Google Gemini API Key (Optional)
# If provided, MULTIPATH will use live Gemini AI inference for
# Socratic Guided Discovery, Feynman Mode persona dialogue, 6-dimension assessments,
# and Adaptive Media generation (Mind Maps, Podcasts, Explainer Videos).
# If omitted or left empty, MULTIPATH automatically runs in Deterministic
# Educational Mode with zero external API dependencies or costs.
GEMINI_API_KEY=

# Gemini Model Identifier (Default: gemini-3.8-flash)
# Can be changed without editing source code (e.g. gemini-2.5-flash, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Server Port (Default: 3001)
PORT=3001

# Supabase Authentication & Profiles (Optional: App runs in Guest Mode if omitted)
# In production / local dev, populate with your project's URL and Publishable Key.
# Never expose service_role secret keys to frontend clients.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

